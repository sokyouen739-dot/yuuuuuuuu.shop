<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <!DOCTYPE html>
<html>
<head>
    <title>Employee Wage Table</title>

    <style>
        body{
            font-family: Arial, sans-serif;
            background: #eeeeee;
        }

        table{
            width: 80%;
            margin: 100px auto;
            border-collapse: collapse;
            text-align: center;
        }

        th, td{
            border: 5px solid orange;
            padding: 20px;
        }

        th{
            font-size: 32px;
            font-weight: bold;
        }

        td{
            font-size: 22px;
        }

        .wage{
            color: orange;
            font-weight: bold;
        }
    </style>
</head>

<body>

<table>
    <tr>
        <th>NAME</th>
        <th>POSITION</th>
        <th>WAGE</th>
    </tr>

    <tr>
        <td>Emma Johnson</td>
        <td>Sales Associate</td>
        <td class="wage">$15.50 per hour</td>
    </tr>

    <tr>
        <td>Liam Thompson</td>
        <td>Customer Service Representative</td>
        <td class="wage">$14.75 per hour</td>
    </tr>

    <tr>
        <td>Olivia Rodriguez</td>
        <td>Marketing Coordinator</td>
        <td class="wage">$18.25 per hour</td>
    </tr>

    <tr>
        <td>Noah Smith</td>
        <td>IT Support Specialist</td>
        <td class="wage">$20.00 per hour</td>
    </tr>

    <tr>
        <td>Ava Davis</td>
        <td>Administrative Assistant</td>
        <td class="wage">$16.80 per hour</td>
    </tr>

</table>

</body>
</html>
</body>
</html>